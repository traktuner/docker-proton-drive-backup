# Where the SQLite DB lives (inside the container)
DB_PATH=/data/backup.db

# Folder browsed in the left "Local files" pane — mount your shares here
LOCAL_ROOT=/sources

# proton-drive CLI integration
PROTON_DRIVE_CLI=/usr/local/bin/proton-drive
# Single persistent dir for session + cache + logs
PROTON_DRIVE_CACHE_DIR=/data/proton
# Use the file-based secret store (CLI 0.6.0+) instead of libsecret/keyring/D-Bus
# (required in Docker; the upstream default "keychain" fails with a machine-id error)
PROTON_DRIVE_CREDENTIALS_STORE=unsafe_file
PROTON_DRIVE_LOG_LEVEL=ERROR
